# ==============================================================================
# Environment Configuration for Command Inbox / Nexus
# Copy this file to .env.local for local development.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Application Base URL (Required: canonical origin for OAuth redirects and auth cookies)
APP_URL=http://localhost:3000

# PostgreSQL Database Connection String (Required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/command-inbox

# Better Auth Configuration (Required)
# Secret key used for signing session tokens and encryption (min 32 characters)
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Corsair Integration Engine (Required)
# 32-byte Base64-encoded Key Encryption Key (KEK) used to encrypt OAuth tokens at rest in database
CORSAIR_KEK=your-corsair-kek
# Corsair Developer API Key (e.g. ck_dev_... or ck_prod_...)
CORSAIR_DEV_API_KEY=your-corsair-dev-api-key
# Signing secret for verifying webhooks and delivery tokens
CORSAIR_DEV_SIGNING_SECRET=your-corsair-dev-signing-secret

# Webhooks & MCP Endpoint Secrets (Optional / Recommended in Production)
WEBHOOK_SECRET=your-webhook-secret-token
MCP_SECRET=your-mcp-bearer-secret-token

# Google OAuth Credentials (Required for Gmail & Google Calendar sync and Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional Social Auth Providers
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# OpenAI API Key (Required for AI agent features)
OPENAI_API_KEY=your-openai-api-key

# AI Spend Protection & Rate Limits
# Maximum messages allowed per user per calendar day (default: 50)
AI_DAILY_MESSAGE_LIMIT=50
# Maximum burst messages allowed per user per minute (default: 8)
AI_BURST_MESSAGE_LIMIT=8
# Global daily token budget cap across all users before soft-capping (default: 2,000,000)
AI_DAILY_TOKEN_BUDGET_TOTAL=2000000

# Access Control & Early-Access Waitlist
# Sign-up access mode: "open" (anyone can sign up) or "invite" (requires ALLOWED_EMAILS or approved waitlist)
SIGNUP_MODE=open
# Comma-separated list of admin emails with access to /dashboard/admin/waitlist
ADMIN_EMAILS=owner@example.com
# Comma-separated list of always-allowed emails (fallback bypass for site owners)
ALLOWED_EMAILS=owner@example.com

# Beta Feedback Configuration
# Optional external feedback form URL (e.g. Google Form, Tally, or GitHub Issues)
NEXT_PUBLIC_FEEDBACK_URL=
# Optional feedback email fallback for mailto link if URL is unset
NEXT_PUBLIC_FEEDBACK_EMAIL=feedback@example.com

# Optional Invite Email (Resend)
# If provided, an invite email is sent when an entry is approved
RESEND_API_KEY=re_123456789
MAIL_FROM=Nexus <invites@yourdomain.com>

